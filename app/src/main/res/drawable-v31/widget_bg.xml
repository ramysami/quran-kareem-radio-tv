<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 launchers have an opinion about widget corner radius; match it
     so this doesn't sit oddly next to every other widget on the screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F0071531" />
    <stroke
        android:width="1dp"
        android:color="@color/panel_stroke" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>
