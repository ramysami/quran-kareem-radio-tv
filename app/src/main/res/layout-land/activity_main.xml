<?xml version="1.0" encoding="utf-8"?>
<!--
  Phone and tablet, landscape.

  Here the screen matches the artwork's own aspect, so it runs full bleed and the
  controls sit over the empty left side, clear of the mosque and lantern. As on
  television, layoutDirection is pinned to ltr: that empty side is on the left in
  the picture, so the panel has to stay there even in Arabic. Text inside still
  shapes right-to-left.

  View ids match the portrait and television variants for view binding.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bg_gradient">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:src="@drawable/bg_default"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <View
        android:id="@+id/scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_soft"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintWidth_percent="0.66"
        app:layout_constraintHorizontal_bias="0" />

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginLeft="@dimen/overscan_horizontal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/titleGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stationName"
                style="@style/Text.Station"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="26sp"
                android:text="@string/station_name" />

            <TextView
                android:id="@+id/stationSubtitle"
                style="@style/Text.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:text="@string/station_subtitle" />

            <View
                android:layout_width="120dp"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/divider_gold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_status" />

            <TextView
                android:id="@+id/statusText"
                style="@style/Text.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:textSize="16sp"
                android:text="@string/status_idle" />
        </LinearLayout>

        <TextView
            android:id="@+id/sleepStatus"
            style="@style/Text.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:textColor="@color/gold"
            android:visibility="gone"
            tools:text="Stops in 14:59"
            tools:visibility="visible" />

        <!--
          What the recogniser thinks is being recited. Shown for the hold time
          from Settings after the last confirmation, then gone again.
        -->
        <LinearLayout
            android:id="@+id/recitationGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="left"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/recitationLabel"
                style="@style/Text.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:textColor="@color/gold"
                android:text="@string/recitation_now" />

            <TextView
                android:id="@+id/recitationSurah"
                style="@style/Text.Station"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="22sp"
                tools:text="Surah Al-Baqarah" />

            <TextView
                android:id="@+id/recitationAyah"
                style="@style/Text.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                tools:text="Ayah 255" />

            <!-- Opens the Ayah in the Quran app (quran://surah/ayah), or on the web -->
            <TextView
                android:id="@+id/btnOpenAyah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="40dp"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/content_on_button"
                android:textSize="14sp"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusDown="@+id/btnPlayPause"
                android:text="@string/action_open_quran" />
        </LinearLayout>

        <!-- Why nothing is shown yet, when recognition is on. Tappable where it says so. -->
        <TextView
            android:id="@+id/recitationHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="380dp"
            android:gravity="left"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Listening for the recitation…" />

        <!-- Primary transport, with the Surah button beside it -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/btnPlayPause"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_primary_height"
                android:minWidth="196dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="22dp"
                android:paddingRight="26dp"
                android:background="@drawable/btn_primary"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusDown="@+id/btnStop"
                android:nextFocusRight="@+id/btnIdentify">

                <ImageView
                    android:id="@+id/playPauseIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play" />

                <TextView
                    android:id="@+id/playPauseLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:textColor="@color/content_on_button"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="@string/action_play" />
            </LinearLayout>

            <!--
              "Which Surah?" — opens a short listening window. Only shown once
              Surah recognition is turned on in Settings.
            -->
            <LinearLayout
                android:id="@+id/btnIdentify"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_primary_height"
                android:layout_marginLeft="10dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="18dp"
                android:background="@drawable/btn_secondary"
                android:focusable="true"
                android:clickable="true"
                android:visibility="gone"
                tools:visibility="visible"
                android:nextFocusLeft="@id/btnPlayPause"
                android:nextFocusDown="@+id/btnSleep">

                <ImageView
                    android:id="@+id/identifyIcon"
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_identify" />

                <TextView
                    android:id="@+id/identifyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:maxLines="1"
                    android:textColor="@color/content_on_button"
                    android:textSize="15sp"
                    android:text="@string/action_identify" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/btnStop"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_secondary_height"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="18dp"
                android:background="@drawable/btn_secondary"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@id/btnPlayPause"
                android:nextFocusRight="@+id/btnSleep">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_stop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:textColor="@color/content_on_button"
                    android:textSize="15sp"
                    android:text="@string/action_stop" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSleep"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_secondary_height"
                android:layout_marginLeft="10dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="18dp"
                android:background="@drawable/btn_secondary"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@id/btnPlayPause"
                android:nextFocusLeft="@id/btnStop"
                android:nextFocusRight="@+id/btnSettings">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_timer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:textColor="@color/content_on_button"
                    android:textSize="15sp"
                    android:text="@string/action_sleep_timer" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_secondary_height"
                android:layout_marginLeft="10dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="@drawable/btn_secondary"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@id/btnPlayPause"
                android:nextFocusLeft="@id/btnSleep">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@string/action_settings"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
