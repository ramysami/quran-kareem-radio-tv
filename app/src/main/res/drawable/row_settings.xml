<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_deep" />
            <corners android:radius="7dp" />
            <stroke android:width="1dp" android:color="@color/gold_bright" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#CC0A1832" />
            <corners android:radius="7dp" />
            <stroke android:width="1dp" android:color="#59D9AE72" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3040A16" />
            <corners android:radius="7dp" />
            <stroke android:width="1dp" android:color="#1FD9AE72" />
        </shape>
    </item>
</selector>
