<?xml version="1.0" encoding="utf-8"?>
<!-- Sits on top of an unknown wallpaper, so rather more opaque than the
     in-app panel it echoes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F0071531" />
    <stroke
        android:width="1dp"
        android:color="@color/panel_stroke" />
    <corners android:radius="18dp" />
</shape>
