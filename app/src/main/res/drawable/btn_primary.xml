<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_dim" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_deep" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/gold_bright" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC050D1C" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#8CD9AE72" />
        </shape>
    </item>
</selector>
