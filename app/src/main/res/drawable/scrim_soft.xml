<?xml version="1.0" encoding="utf-8"?>
<!--
  Portrait, over the bundled artwork. Weighted towards the bottom, where the
  lantern and the patterned floor are brightest, and kept light at the top so the
  gold wordmark in the picture stays clean.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#B3061225"
        android:centerColor="#4D061225"
        android:endColor="#1A061225"
        android:centerY="0.5"
        android:type="linear" />
</shape>
