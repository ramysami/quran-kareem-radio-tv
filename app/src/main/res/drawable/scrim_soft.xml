<?xml version="1.0" encoding="utf-8"?>
<!--
  Portrait. The artwork sits in a hero band across the top, so the scrim runs
  vertically to melt its lower edge into the page rather than cutting a hard
  line across the picture.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#FF061225"
        android:centerColor="#73061225"
        android:endColor="#00061225"
        android:centerY="0.35"
        android:type="linear" />
</shape>
