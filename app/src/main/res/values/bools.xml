<resources>
    <!--
      TV hides its own station title when the bundled artwork is showing, because
      the artwork already carries the wordmark across the whole screen. On a
      phone the artwork is only a band at the top, so the title always earns its
      place. This also gates the vertical nudge that keeps the TV panel clear of
      the artwork's logo.
    -->
    <bool name="is_tv_layout">false</bool>
</resources>
