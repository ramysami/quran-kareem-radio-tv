<?xml version="1.0" encoding="utf-8"?>
<!--
    Standard home-screen widget.

    RemoteViews only knows a handful of view classes, so this is plain nested
    LinearLayout rather than the ConstraintLayout the app screens use — and the
    icons are left empty here because vector drawables are unreliable in a
    widget below API 24; RadioWidgets rasterises them at update time.

    Note there is no click target on the root: tapping the widget itself is
    meant to do nothing at all. Only the two buttons act.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <!--
        The app's own painting, cropped and rounded to the widget's shape by
        RadioWidgets and handed over as a single bitmap.

        Hidden until RadioWidgets has a backdrop to put here, so the widget
        picker's preview and a user who asked for no background image both keep
        the plain panel the frame above draws.
    -->
    <ImageView
        android:id="@+id/widget_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/widget_play_pause"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/widget_btn_round"
            android:contentDescription="@string/action_play"
            android:src="@drawable/ic_play"
            android:padding="15dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/station_name"
                android:textColor="@color/gold_bright"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/dot_status"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_sleep"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/widget_btn_pill"
            android:gravity="center"
            android:minWidth="44dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/widget_sleep_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/action_sleep_timer"
                android:src="@drawable/ic_timer"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_sleep_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/gold_bright"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
