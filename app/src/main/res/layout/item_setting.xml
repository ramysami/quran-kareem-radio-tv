<?xml version="1.0" encoding="utf-8"?>
<!--
  One settings row. Focusable for the D-pad; in touch mode a tap is a click at
  once — focusableInTouchMode would make the first tap merely select the row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/row_settings"
    android:focusable="true"
    android:clickable="true"
    android:duplicateParentState="false">

    <!-- Passes the row's focused state down, so the labels can flip to dark ink -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:duplicateParentState="true">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/content_on_button"
            android:textSize="17sp"
            android:duplicateParentState="true"
            tools:text="Change stream URL" />

        <TextView
            android:id="@+id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/summary_on_button"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="middle"
            android:duplicateParentState="true"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="https://…/a_7a4vuubc6mo8.m3u8" />

        <!-- Only the model row uses this, while its download is running -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:progressTint="@color/gold"
            android:progressBackgroundTint="@color/panel_stroke"
            android:indeterminateTint="@color/gold"
            android:max="100"
            android:visibility="gone"
            tools:visibility="visible"
            tools:progress="40" />
    </LinearLayout>

    <!-- On/off rows show a switch instead of the check mark. Not itself
         clickable: the whole row is the control, as everywhere else here. -->
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:clickable="false"
        android:focusable="false"
        android:duplicateParentState="true"
        android:visibility="gone"
        tools:visibility="visible"
        tools:checked="true" />

    <ImageView
        android:id="@+id/check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginLeft="12dp"
        android:src="@drawable/ic_check"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:visibility="invisible" />
</LinearLayout>
