<?xml version="1.0" encoding="utf-8"?>
<!--
  layoutDirection is pinned to ltr on the root: the artwork is composed with its
  dark, empty area on the left, so the control panel must stay on the left even
  when the TV is set to Arabic. Text inside still shapes bidirectionally.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bg_gradient">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:src="@drawable/bg_default"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <View
        android:id="@+id/scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_left"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintWidth_percent="0.62"
        app:layout_constraintHorizontal_bias="0" />

    <!-- Left-centre control panel -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginLeft="@dimen/overscan_horizontal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.68">

        <!-- Hidden while the default artwork is showing: it already carries the wordmark -->
        <LinearLayout
            android:id="@+id/titleGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/stationName"
                style="@style/Text.Station"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/station_name" />

            <TextView
                android:id="@+id/stationSubtitle"
                style="@style/Text.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/station_subtitle" />

            <View
                android:layout_width="180dp"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/divider_gold" />
        </LinearLayout>

        <!-- Status line -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="18dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_status" />

            <TextView
                android:id="@+id/statusText"
                style="@style/Text.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/status_idle" />
        </LinearLayout>

        <TextView
            android:id="@+id/sleepStatus"
            style="@style/Text.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/gold"
            android:letterSpacing="0.04"
            android:visibility="gone"
            tools:text="Stops in 14:59"
            tools:visibility="visible" />

        <!-- Primary transport -->
        <LinearLayout
            android:id="@+id/btnPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_primary_height"
            android:layout_marginTop="24dp"
            android:minWidth="196dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:paddingRight="24dp"
            android:background="@drawable/btn_primary"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:nextFocusDown="@+id/btnStop">

            <ImageView
                android:id="@+id/playPauseIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_play" />

            <TextView
                android:id="@+id/playPauseLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:textColor="@color/content_on_button"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="@string/action_play" />
        </LinearLayout>

        <!-- Secondary row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/btnStop"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_secondary_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="18dp"
                android:background="@drawable/btn_secondary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusUp="@id/btnPlayPause"
                android:nextFocusRight="@+id/btnSleep">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_stop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:textColor="@color/content_on_button"
                    android:textSize="15sp"
                    android:text="@string/action_stop" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSleep"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_secondary_height"
                android:layout_marginLeft="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="18dp"
                android:background="@drawable/btn_secondary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusUp="@id/btnPlayPause"
                android:nextFocusLeft="@id/btnStop"
                android:nextFocusRight="@+id/btnSettings">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_timer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:textColor="@color/content_on_button"
                    android:textSize="15sp"
                    android:text="@string/action_sleep_timer" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_secondary_height"
                android:layout_marginLeft="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="18dp"
                android:background="@drawable/btn_secondary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusUp="@id/btnPlayPause"
                android:nextFocusLeft="@id/btnSleep">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:textColor="@color/content_on_button"
                    android:textSize="15sp"
                    android:text="@string/action_settings" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
