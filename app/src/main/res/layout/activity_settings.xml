<?xml version="1.0" encoding="utf-8"?>
<!--
  Phone and tablet settings: a single full-width scrolling list. The artwork is
  kept behind a near-opaque scrim rather than dropped entirely, so the screen
  still belongs to the same app without competing with the text.

  View ids match the television variant for view binding.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:src="@drawable/bg_default"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <View
        android:id="@+id/scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_settings"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <TextView
        android:id="@+id/screenTitle"
        style="@style/Text.Station"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="26sp"
        android:layout_marginLeft="@dimen/overscan_horizontal"
        android:layout_marginTop="@dimen/overscan_vertical"
        android:text="@string/settings_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scroller"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/overscan_horizontal"
        android:paddingRight="@dimen/overscan_horizontal"
        android:paddingBottom="@dimen/overscan_vertical"
        android:scrollbars="none"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screenTitle"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                style="@style/Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="2dp"
                android:text="@string/settings_section_stream" />

            <include
                android:id="@+id/rowStreamEdit"
                layout="@layout/item_setting" />

            <include
                android:id="@+id/rowStreamReset"
                layout="@layout/item_setting" />

            <TextView
                style="@style/Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="2dp"
                android:text="@string/settings_section_background" />

            <include
                android:id="@+id/rowBgDefault"
                layout="@layout/item_setting" />

            <include
                android:id="@+id/rowBgNone"
                layout="@layout/item_setting" />

            <include
                android:id="@+id/rowBgCustom"
                layout="@layout/item_setting" />

            <include
                android:id="@+id/rowBgReset"
                layout="@layout/item_setting" />

            <TextView
                style="@style/Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="2dp"
                android:text="@string/settings_section_notification" />

            <include
                android:id="@+id/rowSleepOverlay"
                layout="@layout/item_setting" />

            <!-- ============ Surah recognition ============ -->
            <TextView
                style="@style/Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="2dp"
                android:text="@string/settings_section_recognition" />

            <include
                android:id="@+id/rowRecognitionEnable"
                layout="@layout/item_setting" />

            <include
                android:id="@+id/rowRecognitionSourceRadio"
                layout="@layout/item_setting" />

            <include
                android:id="@+id/rowRecognitionSourceMic"
                layout="@layout/item_setting" />

            <include
                android:id="@+id/rowRecognitionHold"
                layout="@layout/item_setting" />

            <include
                android:id="@+id/rowRecognitionModel"
                layout="@layout/item_setting" />

            <TextView
                android:id="@+id/recognitionCredits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:text="@string/settings_recognition_credits" />

            <TextView
                style="@style/Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="2dp"
                android:text="@string/settings_section_reset" />

            <include
                android:id="@+id/rowResetAll"
                layout="@layout/item_setting" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
